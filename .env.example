# GoDaddy Outgoing SMTP Server
SMTP_HOST=smtpout.secureserver.net

# Port & Security: 465 with SSL
SMTP_PORT=465
SMTP_SECURE=true

# Mailbox Credentials
SMTP_USER=info@devopsminders.com
